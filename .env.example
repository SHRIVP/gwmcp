# Guidewire Cloud PolicyCenter MCP Server
# Copy to .env and fill in your values

# Base URL for PolicyCenter REST API (no trailing slash, no /v1)
# Example: https://mycompany-dev.guidewire.net/pc/rest
GW_BASE_URL=https://{tenant}.guidewire.net/pc/rest

# OAuth 2.0 token endpoint
# Guidewire IDP:  https://{tenant}.guidewire.net/oauth2/token
# Okta:          https://{tenant}.okta.com/oauth2/default/v1/token
GW_TOKEN_URL=https://{your-idp}/oauth2/token

# OAuth 2.0 client credentials
GW_CLIENT_ID=your-client-id
GW_CLIENT_SECRET=your-client-secret

# Optional: space-separated scopes (default: none sent)
# GW_OAUTH_SCOPE=pc:read

# Set to true to use built-in mock data (no Guidewire credentials needed)
# GW_MOCK=true

# Transport: stdio (default, for local use) or sse (for remote/deployed use)
# GW_TRANSPORT=sse

# Port for SSE transport (default 8000, Railway sets this automatically)
# PORT=8000
